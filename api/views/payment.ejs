<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Order Summary</title>
    <% if (paymentConfig && paymentConfig.gatway === 'razorpay') { %>
        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <% } %>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", sans-serif;
        }

        body {
            background: #f2f4f8;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .order-summary {
            width: 420px;
        }

        .card {
            background: #fff;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .card-title {
            font-size: 26px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 24px;
            color: #1f2937;
        }

        .item {
            display: flex;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid #e5e7eb;
        }

        .item:last-child {
            border-bottom: none;
        }

        .item-img {
            width: 56px;
            height: 56px;
            object-fit: contain;
            margin-right: 12px;
        }

        .item-info {
            flex: 1;
        }

        .item-name {
            font-size: 15px;
            font-weight: 600;
            color: #111827;
        }

        .item-variant {
            font-size: 13px;
            color: #6b7280;
            margin-top: 4px;
        }

        .item-qty {
            font-size: 13px;
            color: #6b7280;
            margin-right: 12px;
        }

        .item-price {
            font-weight: 600;
            color: #111827;
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            font-size: 14px;
            color: #374151;
            border-bottom: 1px solid #e5e7eb;
        }

        .price-row.discount {
            color: #15803d;
            font-weight: 600;
        }

        .free {
            color: #15803d;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 16px 0;
            font-size: 18px;
            font-weight: 700;
            color: #111827;
        }

        .total-price {
            color: #15803d;
            font-size: 24px;
        }

        .coupon-box {
            display: flex;
            margin: 16px 0px 8px 0px;
            gap: 8px;
        }

        .coupon-box input {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            outline: none;
            font-size: 14px;
        }

        .coupon-box button {
            padding: 12px 18px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            font-weight: 600;
            cursor: pointer;
        }

        .action-btn {
            margin-top: 10px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            text-align: center;
            padding: 14px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        .footer-links {
            display: flex;
            justify-content: space-between;
            margin-top: 18px;
            font-size: 14px;
            color: #2563eb;
            cursor: pointer;
        }

        .message {
            font-weight: 500;
            margin-left: 10px;
        }

        .input-success {
            border: 2px solid green;
        }

        .input-error {
            border: 2px solid red;
        }

        /* Iframe-friendly adaptive styling */
        body.in-iframe {
            background: transparent;
            min-height: auto;
            display: block;
            padding: 0;
        }

        body.in-iframe .order-summary {
            width: 100%;
            max-width: 100%;
        }

        body.in-iframe .card {
            box-shadow: none;
            padding: 12px 16px;
            border-radius: 0;
            border: none;
            background: transparent;
        }

        body.in-iframe .card-title {
            display: none; /* Hide since the parent modal already has a header */
        }
    </style>
</head>

<body>
    <div class="order-summary">
        <div class="card">
            <div class="card-title">Order Summary</div>
            <% items.items.forEach(item=> { %>
                <div class="item">
                    <% if(item.item.featured_image!=undefined){%>
                        <img src="<%= item.item.featured_image.url %>" class="item-img" />
                        <%} else {%>
                            <img src="/no-photos.png" class="item-img" />
                            <%}%>
                                <div class="item-info">
                                    <div class="item-name">
                                        <%= item.item.name%>
                                    </div>
                                    <div class="item-variant">
                                        <% if (item.variant && item.variant.name) { %>
                                            <%= item.variant.name %>
                                        <% } else { %>
                                            Standard
                                        <% } %>
                                    </div>
                                </div>
                                <div class="item-qty">Qty: <%= item.quantity %>
                                </div>
                                <div class="item-price">
                                    <%= currency_Symbol %>
                                        <%= item.price %>
                                </div>
                </div>
                <% }) %>
                    <div class="price-row">
                        <span>Subtotal</span>
                        <span>
                            <%= currency_Symbol %>
                                <%= items.totalAmount %>
                        </span>
                    </div>
                    <div class="price-row">
                        <span>Shipping</span>
                        <span>
                            <%= currency_Symbol %>
                                <% if(shipping==0){ %>
                                    <span class="free">Free</span>
                                    <% }else { %>
                                        <span>
                                            <%= shipping %>
                                        </span>
                                        <% } %>
                        </span>
                    </div>
                    <div class="price-row discount">
                        <span>Discount</span>
                        <span>- <%= currency_Symbol %>
                                <%= discount%></span>
                    </div>
                    <div class="price-row">
                        <span>Tax</span>
                        <span>
                            <%= tax%>%
                        </span>
                    </div>
                    <div class="total-row">
                        <span>Total</span>
                        <span class="total-price">
                            <%= currency_Symbol %>
                                <%= totalAmount%>
                        </span>
                    </div>
                    <div class="coupon-box" method="post" action="/api/public/ecommerce/verify-coupon">
                        <input type="text" id="couponCode" placeholder="Enter coupon code" name="couponCode" class="" />
                        <button id="coupan_submit">Apply</button>
                    </div>
                    <div id="message" style="color: #ef4444; font-size: 13px; margin: 4px 0 12px 4px; font-weight: 500; text-align: left;"></div>
                    <div class="action-btn">Place Order</div>
        </div>
    </div>
    <script>
        // Check if inside iframe
        if (window.self !== window.top) {
            document.body.classList.add('in-iframe');
        }

        let coupan_code = ""
        const messageBox = document.getElementById("message")
        const coupan_submit = document.querySelector('#coupan_submit')
        const actionBtn = document.querySelector('.action-btn')

        document.getElementById("couponCode").addEventListener('keyup', (e) => {
            coupan_code = e.target.value.trim();
        })

        // Place Order button click event handler (Razorpay & Direct fallback!)
        actionBtn.addEventListener('click', async () => {
            const isRazorpay = "<%= paymentConfig ? paymentConfig.gatway : '' %>" === 'razorpay';
            
            if (isRazorpay) {
                try {
                    const razorpayKey = "<%= paymentConfig ? paymentConfig.key_id : '' %>";
                    const amountInPaise = Math.round(Number("<%= totalAmount %>") * 100);
                    const currencyCode = "<%= currency_code %>";

                    var options = {
                        "key": razorpayKey,
                        "amount": amountInPaise,
                        "currency": currencyCode,
                        "name": "Kodetri Store",
                        "description": "Secure Order Payment",
                        "handler": async function (response) {
                            actionBtn.innerText = "Processing...";
                            actionBtn.style.opacity = "0.7";
                            actionBtn.style.pointerEvents = "none";

                            try {
                                const urlParams = new URLSearchParams(window.location.search);
                                const customerId = urlParams.get('customerId') || "";

                                const orderResponse = await fetch('/api/public/ecommerce/order/place', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify({
                                        customerId,
                                        transactionId: response.razorpay_payment_id,
                                        paymentGateway: "razorpay"
                                    })
                                });

                                const result = await orderResponse.json();

                                if (result.status === "success") {
                                    window.parent.postMessage({ type: 'CHECKOUT_SUCCESS' }, '*');
                                } else {
                                    actionBtn.innerText = "Place Order";
                                    actionBtn.style.opacity = "1";
                                    actionBtn.style.pointerEvents = "all";
                                    alert(result.message || "Failed to process order creation.");
                                }
                            } catch (err) {
                                console.error(err);
                                alert("Failed to complete order submission.");
                            }
                        },
                        "prefill": {
                            "name": "",
                            "email": "",
                            "contact": ""
                        },
                        "theme": {
                            "color": "#2563eb"
                        }
                    };
                    var rzp = new window.Razorpay(options);
                    rzp.open();
                } catch (error) {
                    console.error("Razorpay initiation failed:", error);
                    alert("Unable to open Razorpay payment gateway.");
                }
                return;
            }

            // Direct mock/cash payment integration
            actionBtn.innerText = "Processing...";
            actionBtn.style.opacity = "0.7";
            actionBtn.style.pointerEvents = "none";
            
            try {
                // Get customerId from URL query string
                const urlParams = new URLSearchParams(window.location.search);
                const customerId = urlParams.get('customerId') || "";

                const response = await fetch('/api/public/ecommerce/order/place', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ customerId })
                });

                const result = await response.json();

                if (result.status === "success") {
                    // Post success message to parent Next.js application
                    window.parent.postMessage({ type: 'CHECKOUT_SUCCESS' }, '*');
                } else {
                    actionBtn.innerText = "Place Order";
                    actionBtn.style.opacity = "1";
                    actionBtn.style.pointerEvents = "all";
                    alert(result.message || "Failed to place order");
                }
            } catch (error) {
                console.error(error);
                actionBtn.innerText = "Place Order";
                actionBtn.style.opacity = "1";
                actionBtn.style.pointerEvents = "all";
                alert("An error occurred while placing your order.");
            }
        });

        coupan_submit.addEventListener('click', async (e) => {
            e.preventDefault();
            const payload = {
                couponCode: coupan_code
            }

            if (coupan_code == "") {
                messageBox.innerText = "Please enter coupon code"
                return;
            }

            const response = await fetch('/api/public/ecommerce/verify-coupon', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });
            const result = await response.json();
            const couponInput = document.getElementById("couponCode");

            if (result.status === "success") {
                couponInput.value = "";
                couponInput.placeholder = result.message;
                couponInput.classList.remove("input-error");
                couponInput.classList.add("input-success");
                messageBox.innerText = "";
            } else {
                couponInput.value = "";
                couponInput.placeholder = result.message;
                couponInput.classList.remove("input-success");
                couponInput.classList.add("input-error");
                messageBox.innerText = result.message || "Invalid coupon";
            }
            console.log("Result:", result);
        })
    </script>
</body>

</html>